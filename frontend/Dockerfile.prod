# ═══════════════════════════════════════════════════════════════
#  Resolve PM v1.3 — Frontend Production Dockerfile
#  Stage 1: Build (Node 20 + Vite)
#  Stage 2: Serve (Nginx Alpine — minimal attack surface)
# ═══════════════════════════════════════════════════════════════

# ── Stage 1: Build ──────────────────────────────────────────
FROM node:20-alpine AS builder

# Build-time environment variables (injected from docker-compose build args)
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_PRODUCT_KEY_API_URL
ARG VITE_APP_VERSION=1.3.0-internal-stable
ARG VITE_BUILD_ENV=production

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_PRODUCT_KEY_API_URL=$VITE_PRODUCT_KEY_API_URL \
    VITE_APP_VERSION=$VITE_APP_VERSION \
    VITE_BUILD_ENV=$VITE_BUILD_ENV \
    NODE_ENV=production

WORKDIR /app

# Copy dependency manifests first for layer caching
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

# Copy source and build
COPY . .
RUN npm run build

# ── Stage 2: Serve ──────────────────────────────────────────
FROM nginx:1.27-alpine AS production

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from Stage 1
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Create health check endpoint
RUN echo "OK" > /usr/share/nginx/html/health

# Non-root user for security
RUN addgroup -S resolvepm && adduser -S resolvepm -G resolvepm
RUN chown -R resolvepm:resolvepm /usr/share/nginx/html
RUN chown -R resolvepm:resolvepm /var/cache/nginx
RUN chown -R resolvepm:resolvepm /var/log/nginx

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:80/health || exit 1

CMD ["nginx", "-g", "daemon off;"]
