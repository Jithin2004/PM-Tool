# Supabase Configuration
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# Backend Services
VITE_PRODUCT_KEY_API_URL="https://license.yourdomain.com"

# Webhooks & Integrations
VITE_WEBHOOK_SECRET="your_webhook_secret"

# Frontend Configuration
VITE_BASE_PATH="/"

# AI Capabilities
# WARNING: This API key is exposed to the frontend bundle via vite.config.ts!
# Do not use an unrestricted production key here in a public-facing application without appropriate rate limits.
GEMINI_API_KEY="your_gemini_api_key"
