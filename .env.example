# Resolve PM v1.3 — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ═══════════════════════════════════════════════════
#  Database (PostgreSQL)
# ═══════════════════════════════════════════════════
POSTGRES_DB=resolvepm
POSTGRES_USER=resolvepm_admin
POSTGRES_PASSWORD=<strong-random-password-here>
POSTGRES_PORT=5432

# ═══════════════════════════════════════════════════
#  Supabase (if using Supabase-hosted database)
# ═══════════════════════════════════════════════════
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ═══════════════════════════════════════════════════
#  Application
# ═══════════════════════════════════════════════════
APP_PORT=3000
VITE_APP_VERSION=1.3.0-internal-stable
VITE_BUILD_ENV=production

# ═══════════════════════════════════════════════════
#  License Server
# ═══════════════════════════════════════════════════
LICENSE_PORT=10000
VITE_PRODUCT_KEY_API_URL=http://localhost:10000
