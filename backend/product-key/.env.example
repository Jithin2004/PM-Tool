# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Primary MongoDB connection URI.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Fallback MongoDB variables (used by some hosting environments)
DATABASE_URL=
DB=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=10000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. 
# Localhost is preserved automatically for development.
ALLOWED_ORIGINS=http://localhost:5173,https://resolve-pm.vercel.app

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Secret used by THIS SERVER to sign license tokens (e.g. { key, workspaceId }).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (server-side variable — no VITE_ prefix on the backend).
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase Anon Key (used for token verification)
SUPABASE_ANON_KEY=

# Supabase Service Role Key (used for orchestration and provisioning)
# KEEP SECRET — has full database access.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Security ─────────────────────────────────────────────────────────────────
# Secret for protecting /admin/* endpoints.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LICENSE_ADMIN_SECRET=

# Comma-separated list of allowed frontend origins (no trailing slash).
# Example: https://app.yourdomain.com,https://staging.yourdomain.com
# Requests from unlisted origins will be rejected with a CORS error.
ALLOWED_ORIGINS=https://app.yourdomain.com

# ─── Logging ──────────────────────────────────────────────────────────────────
# Pino log level. Options: trace, debug, info, warn, error, fatal
# Default: info
LOG_LEVEL=info

# ─── License Seeding ──────────────────────────────────────────────────────────
# Used ONLY by the seed_licenses.js script — never read at runtime.
# Comma-separated list of license keys to seed into MongoDB.
# Run:  node seed_licenses.js
# Keys hardcoded in source code have been removed. Use this instead.
# SEED_LICENSE_KEYS=KEY1-HERE,KEY2-HERE,KEY3-HERE
# SEED_LICENSE_PLAN=BUSINESS
# SEED_LICENSE_LIMIT=3
