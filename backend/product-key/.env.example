# MongoDB Connection URI (Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority)
MONGO_URI=mongodb+srv://resolve_pm_app_user:REPLACE_WITH_PASSWORD@your-cluster.mongodb.net/resolve_pm_prod?retryWrites=true&w=majority

# Fallback MongoDB variables (if required by your hosting environment like Render)
DATABASE_URL=
DB=

# Server Port
PORT=5002

# Internal API Secret for backend-to-backend communication
INTERNAL_API_SECRET=your_super_secret_internal_key_here

# JWT Secret for signing and verifying tokens
JWT_SECRET=your_jwt_secret_here

# License Admin Secret for protecting backend admin endpoints
LICENSE_ADMIN_SECRET=change_me
